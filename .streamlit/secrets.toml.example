# Copy this into Streamlit Cloud: your app -> Settings -> Secrets.
#
# Do NOT create a real .streamlit/secrets.toml in the repository. It is
# gitignored, but the safer habit is that secrets only ever exist in the
# hosting platform's secret store and in your own password manager.
#
# Whoever deploys the app sets these. They are not shared with anyone else,
# and they are not needed to review or run the code — `desk demo` works with
# no secrets at all.

# ── Required ────────────────────────────────────────────────────────────────

# How the app authenticates. No default exists: if this is missing or
# misspelled the app refuses to start rather than serving without a gate.
#   passcode | oidc | demo | none
DESK_AUTH_MODE = "passcode"

# Set to "prod" for a hosted deployment. This makes a missing database URL a
# hard failure instead of silently creating an empty local file — which on a
# host with an ephemeral filesystem looks exactly like losing all your history.
DESK_APP_ENV = "prod"

# Postgres. Required when DESK_APP_ENV is "prod"; SQLite is refused there
# because hosted filesystems do not survive a restart.
# Free options: Neon (neon.tech) or Supabase.
# Use a scoped role with SELECT/INSERT/UPDATE, not the database owner.
DESK_DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# ── Required when DESK_AUTH_MODE = "passcode" ───────────────────────────────

# An argon2id hash, never the passcode itself. Generate it with:
#     desk hash-passcode
# The command prompts, so the passcode never lands in your shell history.
DESK_PASSCODE_HASH = "$argon2id$v=19$m=65536,t=3,p=4$REPLACE$REPLACE"

# 32 random bytes signing the session cookie. Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out, which is the intended way to revoke access.
DESK_SESSION_SECRET = "replace-with-32-random-bytes-in-hex"

# ── Required instead when DESK_AUTH_MODE = "oidc" ───────────────────────────

# Google sign-in restricted to an explicit list of verified addresses. The app
# refuses to start if the allowlist is empty, because an OIDC login with no
# allowlist authenticates the entire internet.
# DESK_OIDC_CLIENT_ID = "..."
# DESK_OIDC_CLIENT_SECRET = "..."
# DESK_ALLOWED_EMAILS = "you@example.com"

# ── Optional ────────────────────────────────────────────────────────────────

# Session lifetime. Both are enforced server-side on every interaction.
# DESK_SESSION_ABSOLUTE_HOURS = 12
# DESK_SESSION_IDLE_MINUTES = 60

# Increment to invalidate every outstanding session without rotating the
# signing secret.
# DESK_SESSION_EPOCH = 1

# Login attempt limiting.
# DESK_LOGIN_MAX_ATTEMPTS = 5
# DESK_LOGIN_WINDOW_MINUTES = 15

# Path to the portfolio configuration file, if not config/portfolio.yaml.
# DESK_CONFIG_PATH = "config/portfolio.yaml"
